NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ---- Database (Supabase in production) ----
# Local: your Postgres. Production: Supabase POOLED connection (port 6543, transaction mode).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/musiqa?schema=public
# Prisma migrations need a DIRECT connection. Local: same as DATABASE_URL.
# Supabase: the DIRECT connection string (port 5432).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/musiqa?schema=public

# ---- Redis (caching + session-reminder queue) ----
# On the VPS run Redis >= 5 (e.g. redis:7 via docker compose) and set reminders=true.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_REMINDERS_ENABLED=true

# ---- Auth ----
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ---- CORS ----
# Comma-separated list of the deployed frontend origins (no trailing slash).
# e.g. https://musicarth.com,https://app.musicarth.com,https://teach.musicarth.com,https://admin.musicarth.com
CORS_ORIGINS=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ---- Invite links (where set-password emails point) ----
STUDENT_APP_URL=http://localhost:5174
INSTRUCTOR_APP_URL=http://localhost:5175

# ---- Mux (video) ----
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# ---- Daily (live sessions) ----
DAILY_API_KEY=
DAILY_DOMAIN=

# ---- Email (Resend) — optional; invites log to console if unset ----
RESEND_API_KEY=
MAIL_FROM=Musicarth <onboarding@yourdomain.com>

# ---- Search (Meilisearch) — optional; falls back to DB search if unset ----
MEILI_HOST=
MEILI_API_KEY=

# ---- Admin seed (used by `npm run seed`) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Object storage for images (Supabase Storage). If unset, images fall back to inline data-URLs.
SUPABASE_URL=https://gsoytqrqrhzkppkxvjbu.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=media
